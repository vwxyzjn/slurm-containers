diff --git a/src/plugins/sched/backfill/backfill.c b/src/plugins/sched/backfill/backfill.c
index 73d1a66d93..bfc4803566 100644
--- a/src/plugins/sched/backfill/backfill.c
+++ b/src/plugins/sched/backfill/backfill.c
@@ -109,0 +110 @@
+#define BF_HETJOB_STICKY_PREEMPT_TIMEOUT 1800
@@ -157,0 +159 @@ typedef struct {
+	time_t sticky_preempt_start;	/* Partial start waiting on preemption */
@@ -159,0 +162,6 @@ typedef struct {
+typedef enum {
+	HET_START_OK = SLURM_SUCCESS,
+	HET_START_FAILED = SLURM_ERROR,
+	HET_START_WAIT_PREEMPT = 1,
+} het_start_rc_t;
+
@@ -225,0 +234,2 @@ static uint16_t bf_hetjob_prio = 0;
+static int bf_hetjob_sticky_preempt_timeout =
+	BF_HETJOB_STICKY_PREEMPT_TIMEOUT;
@@ -1000,0 +1011,14 @@ static void _load_config(void)
+	bf_hetjob_sticky_preempt_timeout = BF_HETJOB_STICKY_PREEMPT_TIMEOUT;
+	if ((tmp_ptr = xstrcasestr(sched_params,
+				   "bf_hetjob_sticky_preempt_timeout="))) {
+		bf_hetjob_sticky_preempt_timeout =
+			atoi(tmp_ptr + strlen("bf_hetjob_sticky_preempt_timeout="));
+		if (bf_hetjob_sticky_preempt_timeout < 0) {
+			error("Invalid SchedulerParameters "
+			      "bf_hetjob_sticky_preempt_timeout: %d",
+			      bf_hetjob_sticky_preempt_timeout);
+			bf_hetjob_sticky_preempt_timeout =
+				BF_HETJOB_STICKY_PREEMPT_TIMEOUT;
+		}
+	}
+
@@ -4131,0 +4156 @@ static void _het_job_start_clear(void)
+			map->sticky_preempt_start = 0;
@@ -4411 +4436,19 @@ static bool _het_job_limit_check(het_job_map_t *map, time_t now)
-static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
+static bool _het_job_component_started(job_record_t *job_ptr)
+{
+	return IS_JOB_RUNNING(job_ptr) || IS_JOB_CONFIGURING(job_ptr);
+}
+
+static void _het_job_add_used_nodes(bitstr_t **used_bitmap,
+				    job_record_t *job_ptr)
+{
+	if (!job_ptr->node_bitmap)
+		return;
+
+	if (!*used_bitmap)
+		*used_bitmap = bit_copy(job_ptr->node_bitmap);
+	else
+		bit_or(*used_bitmap, job_ptr->node_bitmap);
+}
+
+static het_start_rc_t _het_job_start_now(het_job_map_t *map,
+					 node_space_map_t *node_space)
@@ -4418,0 +4462,2 @@ static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
+	het_start_rc_t start_rc = HET_START_OK;
+	bool any_component_started = false;
@@ -4433,0 +4479,6 @@ static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
+		if (_het_job_component_started(job_ptr)) {
+			any_component_started = true;
+			_het_job_add_used_nodes(&used_bitmap, job_ptr);
+			continue;
+		}
+
@@ -4444,0 +4496 @@ static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
+			start_rc = HET_START_FAILED;
@@ -4477,4 +4529,2 @@ static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
-			if (!used_bitmap && job_ptr->node_bitmap)
-				used_bitmap = bit_copy(job_ptr->node_bitmap);
-			else if (job_ptr->node_bitmap)
-				bit_or(used_bitmap, job_ptr->node_bitmap);
+			any_component_started = true;
+			_het_job_add_used_nodes(&used_bitmap, job_ptr);
@@ -4481,0 +4532,4 @@ static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
+			bool preempt_wait =
+				job_ptr->preempt_in_progress ||
+				(job_ptr->details &&
+				 job_ptr->details->preempt_start_time);
@@ -4482,0 +4537,8 @@ static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
+			if (bf_hetjob_sticky_preempt_timeout &&
+			    any_component_started &&
+			    (rc == ESLURM_NODES_BUSY) &&
+			    preempt_wait) {
+				start_rc = HET_START_WAIT_PREEMPT;
+			} else {
+				start_rc = HET_START_FAILED;
+			}
@@ -4510 +4572 @@ static int _het_job_start_now(het_job_map_t *map, node_space_map_t *node_space)
-	return rc;
+	return start_rc;
@@ -4524,0 +4587 @@ static void _het_job_kill_now(het_job_map_t *map)
+	map->sticky_preempt_start = 0;
@@ -4566 +4629 @@ static bool _het_job_start_test_single(node_space_map_t *node_space,
-	int rc;
+	het_start_rc_t rc;
@@ -4596,0 +4660,18 @@ static bool _het_job_start_test_single(node_space_map_t *node_space,
+	if (rc == HET_START_WAIT_PREEMPT) {
+		if (!map->sticky_preempt_start)
+			map->sticky_preempt_start = now;
+
+		if ((now - map->sticky_preempt_start) <=
+		    bf_hetjob_sticky_preempt_timeout) {
+			log_flag(HETJOB, "Hetjob %u partially started; waiting for preemption cleanup",
+				 map->het_job_id);
+			map->prev_start = now + 1;
+			return false;
+		}
+
+		log_flag(HETJOB, "Hetjob %u sticky preempt timeout expired; rolling back",
+			 map->het_job_id);
+		_het_job_kill_now(map);
+		return false;
+	}
+
@@ -4600,0 +4682 @@ static bool _het_job_start_test_single(node_space_map_t *node_space,
+		map->sticky_preempt_start = 0;
