+		comp_time_limit = job_ptr->time_limit;
+	if (job_ptr->het_job_id) {
+		map = list_find_first(het_job_list, _het_job_find_map,
+				      &job_ptr->het_job_id);
+		if (map) {
+			if (map->launch_state == HET_LAUNCH_COMMITTED)
+				return;
