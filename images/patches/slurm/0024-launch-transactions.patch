+static void _het_job_start_set(job_record_t *job_ptr, time_t latest_start,
+			       uint32_t comp_time_limit,
+			       bitstr_t *planned_node_bitmap,
+			       list_t *planned_preemptee_job_ids)
+{
+	het_job_map_t *map;
+	het_job_rec_t *rec;
