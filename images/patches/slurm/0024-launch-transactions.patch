+	iter = list_iterator_create(het_job_ptr->het_job_list);
+	while ((job_ptr = list_next(iter))) {
+		if ((job_ptr->magic != JOB_MAGIC) ||
+		    (job_ptr->het_job_id != map->het_job_id)) {
+			rc = false;	/* bad job pointer */
