diff --git a/src/plugins/cgroup/v2/task_delegation.h b/src/plugins/cgroup/v2/task_delegation.h
new file mode 100644
index 0000000..bb614f4
--- /dev/null
+++ b/src/plugins/cgroup/v2/task_delegation.h
@@ -0,0 +1,231 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Memory-only delegation below a Slurm-owned task cgroup. */
+#ifndef _TASK_DELEGATION_H
+#define _TASK_DELEGATION_H
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <linux/magic.h>
+#include <sys/vfs.h>
+
+#define DELEGATION_DIR "delegated"
+#define DELEGATION_LEAF "delegated/main"
+#define DELEGATION_MAX_DESCENDANTS "258"
+#define DELEGATION_MAX_DEPTH "6"
+
+static int _deleg_open_dir(int parent, const char *name)
+{
+	return openat(parent, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+}
+
+static int _deleg_write(int dir, const char *name, const char *value)
+{
+	int fd, rc = -1, saved;
+	size_t len = strlen(value);
+	ssize_t n;
+
+	fd = openat(dir, name, O_WRONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	do {
+		n = write(fd, value, len);
+	} while ((n < 0) && (errno == EINTR));
+	if (n == (ssize_t) len)
+		rc = 0;
+	else if (n >= 0)
+		errno = EIO;
+	saved = errno;
+	close(fd);
+	errno = saved;
+	return rc;
+}
+
+static int _deleg_chown(int dir, uid_t uid, gid_t gid)
+{
+	const char *files[] = {
+		"cgroup.procs", "cgroup.threads", "cgroup.subtree_control"
+	};
+	size_t i;
+
+	/* Never chown memory.max, the limits on the subtree, or any ancestor. */
+	for (i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		int fd = openat(dir, files[i], O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+		int rc, saved;
+
+		if (fd < 0)
+			return -1;
+		rc = fchown(fd, uid, gid);
+		saved = errno;
+		close(fd);
+		if (rc) {
+			errno = saved;
+			return -1;
+		}
+	}
+	/* Hand over the directory last, after all root-owned setup is complete. */
+	return fchown(dir, uid, gid);
+}
+
+static int _deleg_check_fs(int fd)
+{
+	struct statfs fs;
+
+	if (fstatfs(fd, &fs))
+		return -1;
+	if (fs.f_type != CGROUP2_SUPER_MAGIC) {
+		errno = EINVAL;
+		return -1;
+	}
+	return 0;
+}
+
+/* Called on a newly-created, still-empty task cgroup, before user exec. */
+static int _deleg_prepare(int task, uid_t uid, gid_t gid)
+{
+	int dir = -1, leaf = -1, rc = -1, saved;
+	struct stat st;
+
+	if (_deleg_check_fs(task) || fstat(task, &st))
+		return -1;
+	if (st.st_uid || (st.st_mode & 0022)) {
+		errno = EPERM;
+		return -1;
+	}
+	/* Bound even a job that never cooperates with directory cleanup. */
+	if (_deleg_write(task, "cgroup.max.descendants", DELEGATION_MAX_DESCENDANTS) ||
+	    _deleg_write(task, "cgroup.max.depth", DELEGATION_MAX_DEPTH) ||
+	    _deleg_write(task, "cgroup.subtree_control", "+memory") ||
+	    mkdirat(task, DELEGATION_DIR, 0755))
+		return -1;
+	if ((dir = _deleg_open_dir(task, DELEGATION_DIR)) < 0)
+		goto out;
+	if (_deleg_write(dir, "cgroup.subtree_control", "+memory") ||
+	    mkdirat(dir, "main", 0755))
+		goto out;
+	if ((leaf = _deleg_open_dir(dir, "main")) < 0)
+		goto out;
+	if (_deleg_chown(leaf, uid, gid) || _deleg_chown(dir, uid, gid))
+		goto out;
+	rc = 0;
+out:
+	saved = errno;
+	if (leaf >= 0)
+		close(leaf);
+	if (dir >= 0)
+		close(dir);
+	errno = saved;
+	return rc;
+}
+
+/* Traverse by directory descriptors, never by a user-controlled path. */
+static int _deleg_walk(int dir, int (*emit)(pid_t, void *), void *arg,
+		       bool remove_children)
+{
+	struct dirent *entry;
+	DIR *stream;
+	int fd, rc = 0, saved;
+
+	if (emit) {
+		FILE *procs;
+		long pid;
+		int scan;
+
+		fd = openat(dir, "cgroup.procs", O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+		if (fd < 0)
+			return (errno == ENOENT) ? 0 : -1;
+		if (!(procs = fdopen(fd, "r"))) {
+			close(fd);
+			return -1;
+		}
+		while ((scan = fscanf(procs, "%ld", &pid)) == 1) {
+			if ((pid <= 0) || (pid > INT_MAX)) {
+				rc = -1;
+				errno = EINVAL;
+				break;
+			}
+			if ((rc = emit((pid_t) pid, arg)))
+				break;
+		}
+		if (!rc && ((scan != EOF) || ferror(procs))) {
+			rc = -1;
+			errno = EIO;
+		}
+		saved = errno;
+		fclose(procs);
+		errno = saved;
+		if (rc)
+			return rc;
+	}
+	fd = _deleg_open_dir(dir, ".");
+	if (fd < 0)
+		return -1;
+	if (!(stream = fdopendir(fd))) {
+		close(fd);
+		return -1;
+	}
+	for (;;) {
+		struct stat st;
+		int child;
+
+		errno = 0;
+		entry = readdir(stream);
+		if (!entry) {
+			if (errno)
+				rc = -1;
+			break;
+		}
+		if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+			continue;
+		if (fstatat(dir, entry->d_name, &st, AT_SYMLINK_NOFOLLOW)) {
+			if (errno == ENOENT)
+				continue;
+			rc = -1;
+			break;
+		}
+		if (!S_ISDIR(st.st_mode))
+			continue;
+		child = _deleg_open_dir(dir, entry->d_name);
+		if (child < 0) {
+			if (errno == ENOENT)
+				continue;
+			rc = -1;
+			break;
+		}
+		if (remove_children && fchown(child, 0, 0))
+			rc = -1;
+		else
+			rc = _deleg_walk(child, emit, arg, remove_children);
+		saved = errno;
+		close(child);
+		errno = saved;
+		if (rc)
+			break;
+		if (remove_children && unlinkat(dir, entry->d_name, AT_REMOVEDIR) &&
+		    (errno != ENOENT)) {
+			rc = -1;
+			break;
+		}
+	}
+	saved = errno;
+	closedir(stream);
+	errno = saved;
+	return rc;
+}
+
+static int _deleg_cleanup(int task)
+{
+	/* Slurm has already killed and waited for the step's processes. */
+	if (_deleg_check_fs(task))
+		return -1;
+	return _deleg_walk(task, NULL, NULL, true);
+}
+
+#endif
