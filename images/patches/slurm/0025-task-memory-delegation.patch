+static int _delegation_requested(stepd_step_rec_t *step)
+{
+	char *value;
+
+	if (!step || !step->env ||
+	    !(value = getenvp(step->env, "SLURM_CGROUP_DELEGATE")))
+		return 0;
+	if (strcmp(value, "memory")) {
+		error("SLURM_CGROUP_DELEGATE must be 'memory' when set");
+		return -1;
+	}
+	if (!slurm_cgroup_conf.enable_task_delegation) {
+		error("SLURM_CGROUP_DELEGATE requires EnableTaskDelegation=yes in cgroup.conf");
+		return -1;
+	}
+	return 1;
+}
+
+static int _collect_delegated_pid(pid_t pid, void *arg)
+{
+	foreach_pid_array_t *a = arg;
+
+	if (a->npids == a->capacity) {
+		if (a->capacity > INT_MAX - 64) {
+			errno = EOVERFLOW;
+			return -1;
+		}
+		a->capacity += 64;
+		xrealloc(a->pids, sizeof(*a->pids) * a->capacity);
+	}
+	a->pids[a->npids++] = pid;
+	return 0;
+}
+
+static int _task_pids(task_cg_info_t *t, pid_t **pids, int *npids)
+{
+	foreach_pid_array_t a = { 0 };
+	int fd, rc;
+
+	if (!t->delegated)
+		return common_cgroup_get_pids(&t->task_cg, pids, npids);
+	fd = open(t->task_cg.path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return SLURM_ERROR;
+	rc = _deleg_walk(fd, _collect_delegated_pid, &a, false);
+	close(fd);
+	if (rc) {
+		xfree(a.pids);
+		return SLURM_ERROR;
+	}
+	*pids = a.pids;
+	*npids = a.npids;
+	return SLURM_SUCCESS;
+}
