 			    (rc == ESLURM_NODES_BUSY) &&
-			    (preempt_wait || map->sticky_preempt_start)) {
+			    (preempt_wait || map->sticky_preempt_start ||
+			     _het_job_preempt_planned_jobs(job_ptr, rec))) {
 				start_rc = HET_START_WAIT_PREEMPT;
 			} else {
 				start_rc = HET_START_FAILED;
