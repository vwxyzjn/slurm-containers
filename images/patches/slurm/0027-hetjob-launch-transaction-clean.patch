+	bool found = false;
+
+	if (!map || !job_ptr)
+		return false;
+
+	iter = list_iterator_create(map->het_job_rec_list);
+	while ((rec = list_next(iter))) {
+		if (rec->job_id == job_ptr->job_id) {
