+{
+	job_record_t *job_ptr;
+
+	if (!map || !rec)
+		return NULL;
+
+	job_ptr = find_job_record(rec->job_id);
+	if (!job_ptr || (job_ptr->het_job_id != map->het_job_id))
+		return NULL;
+
+	rec->job_ptr = job_ptr;
+	return job_ptr;
+}
