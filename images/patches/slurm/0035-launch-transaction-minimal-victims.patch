+extern void bf_launch_txn_set_preemption_handoff(bool enabled)
+{
+	slurm_mutex_lock(&bf_launch_txn_nodes_mutex);
+	bf_launch_txn_preemption_handoff = enabled;
+	slurm_mutex_unlock(&bf_launch_txn_nodes_mutex);
+}
+
+static bool _bf_launch_txn_should_defer_preemption(uint32_t scheduler_type)
+{
+	bool defer;
+
+	if (!(scheduler_type & (SLURMDB_JOB_FLAG_SUBMIT |
+				SLURMDB_JOB_FLAG_SCHED)))
+		return false;
+
+	slurm_mutex_lock(&bf_launch_txn_nodes_mutex);
+	defer = bf_launch_txn_preemption_handoff;
+	slurm_mutex_unlock(&bf_launch_txn_nodes_mutex);
+
+	return defer;
+}
