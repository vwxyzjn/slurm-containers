+extern bool bf_launch_txn_share_nodes(uint32_t *members, uint32_t count)
+{
+	bf_launch_txn_nodes_t *records[32] = { 0 };
+	bf_launch_txn_nodes_t *record;
+	list_itr_t *iter;
+	uint32_t array_id = 0;
+	bool valid = false;
+
+	if (!members || (count < 2) || (count > 32))
+		return false;
+	for (uint32_t member = 0; member < count; member++) {
+		job_record_t *job_ptr = find_job_record(members[member]);
+
+		if (!job_ptr || !IS_JOB_PENDING(job_ptr) ||
+		    !job_ptr->bf_launch_transaction || !job_ptr->array_job_id ||
+		    job_ptr->het_job_id)
+			return false;
+		if (!array_id)
+			array_id = job_ptr->array_job_id;
+		if (array_id != job_ptr->array_job_id)
+			return false;
+		for (uint32_t prior = 0; prior < member; prior++) {
+			if (members[prior] == members[member])
+				return false;
+		}
+	}
+	slurm_mutex_lock(&bf_launch_txn_nodes_mutex);
+	if (!bf_launch_txn_nodes)
+		goto done;
+	iter = list_iterator_create(bf_launch_txn_nodes);
+	while ((record = list_next(iter))) {
+		for (uint32_t member = 0; member < count; member++) {
+			if (record->owner_id == members[member])
+				records[member] = record;
+		}
+	}
+	list_iterator_destroy(iter);
+	for (uint32_t member = 0; member < count; member++) {
+		if (!records[member] || records[member]->batch_size ||
+		    !bit_equal(records[0]->node_bitmap,
+			       records[member]->node_bitmap))
+			goto done;
+	}
+	for (uint32_t member = 0; member < count; member++) {
+		records[member]->batch_members = xcalloc(count, sizeof(*members));
+		memcpy(records[member]->batch_members, members,
+		       count * sizeof(*members));
+		records[member]->batch_size = count;
+	}
+	valid = true;
+done:
+	slurm_mutex_unlock(&bf_launch_txn_nodes_mutex);
+	return valid;
+}
