+
+list_t *__wrap_slurm_find_preemptable_jobs(job_record_t *job_ptr)
+{
+	list_t *candidates = list_create(NULL);
+
+	for (uint32_t victim = 0; victim < 8; victim++)
+		list_append(candidates, batch_victims[victim]);
+	return candidates;
+}
+
+int __wrap_select_g_job_test(job_record_t *job_ptr, bitstr_t *bitmap,
+	uint32_t min_nodes, uint32_t max_nodes, uint32_t req_nodes, uint16_t mode,
+	list_t *candidates, list_t **selected, resv_exc_t *resv_exc,
+	will_run_data_t *will_run)
+{
+	uint32_t count = job_ptr->details->num_tasks;
+	gres_state_t *gres = list_peek(job_ptr->gres_list_req);
+	gres_job_state_t *request = gres->gres_data;
+
+	REQUIRE(mode == SELECT_MODE_RUN_NOW);
+	REQUIRE(min_nodes == 1 && max_nodes == 1 && req_nodes == 1);
+	REQUIRE(bit_set_count(bitmap) == 1);
+	REQUIRE(job_ptr->details->min_cpus == 12 * count);
+	REQUIRE(job_ptr->details->cpus_per_task == 12);
+	REQUIRE(job_ptr->details->ntasks_per_node == count);
+	REQUIRE(request->gres_per_task == 1);
+	REQUIRE(request->total_gres == count);
+	if (job_ptr->details->pn_min_memory & MEM_PER_CPU)
+		REQUIRE(job_ptr->details->pn_min_memory == (MEM_PER_CPU | 4096));
+	else
+		REQUIRE(job_ptr->details->pn_min_memory == 131072 * count);
+	if (count > probe_capacity)
+		return ESLURM_NODES_BUSY;
+	*selected = list_create(NULL);
+	for (uint32_t victim = 0; victim < count; victim++)
+		list_append(*selected, batch_victims[victim]);
+	return SLURM_SUCCESS;
+}
+
+bool __real_bf_launch_txn_share_nodes(uint32_t *members, uint32_t count);
+
+bool __wrap_bf_launch_txn_share_nodes(uint32_t *members, uint32_t count)
+{
+	if (reject_admission)
+		return false;
+	return __real_bf_launch_txn_share_nodes(members, count);
+}
+
+static job_record_t *gpu_array(uint32_t array_id, uint32_t tasks, uint32_t limit)
+{
+	job_record_t *owner = new_array(array_id, tasks, limit);
+	job_details_t *details = owner->details;
+	gres_state_t *gres = xmalloc(sizeof(*gres));
+	gres_job_state_t *request = xmalloc(sizeof(*request));
+
+	details->num_tasks = 1;
+	details->min_nodes = details->max_nodes = 1;
+	details->min_cpus = details->orig_min_cpus = 12;
+	details->max_cpus = details->orig_max_cpus = NO_VAL;
+	details->cpus_per_task = details->orig_cpus_per_task = 12;
+	details->pn_min_memory = details->orig_pn_min_memory = 131072;
+	details->mc_ptr = xmalloc(sizeof(*details->mc_ptr));
+	details->mc_ptr->ntasks_per_socket = INFINITE16;
+	gres->gres_name = xstrdup("gpu");
+	gres->state_type = GRES_STATE_TYPE_JOB;
+	gres->gres_data = request;
+	request->gres_per_task = request->total_gres = 1;
+	owner->gres_list_req = list_create(NULL);
+	list_append(owner->gres_list_req, gres);
+	for (uint32_t victim = 0; victim < 8; victim++) {
+		batch_victims[victim] = new_job(array_id + 10000 + victim,
+					       JOB_RUNNING);
+		batch_victims[victim]->node_bitmap = bit_alloc(64);
+		bit_set(batch_victims[victim]->node_bitmap, 8);
+	}
+	return owner;
+}
+
+static job_launch_t *open_batch(job_record_t *owner)
+{
+	bitstr_t *nodes = bit_alloc(64);
+	list_t *victims = NULL;
+	resv_exc_t exclusions = { 0 };
+	job_launch_t *plan;
+
+	bit_set(nodes, 8);
+	_het_job_append_job_id(&victims, batch_victims[0]->job_id);
+	plan = _job_launch_begin_array_batch(owner, &test_partition, NULL,
+		NULL, false, nodes, victims, &exclusions, 3600);
+	FREE_NULL_BITMAP(nodes);
+	FREE_NULL_LIST(victims);
+	return plan;
+}
+
+static bool node_visible(job_record_t *job_ptr)
+{
+	bitstr_t *nodes = bit_copy(test_partition.node_bitmap);
+	bool visible;
+
+	bf_launch_txn_filter_nodes(job_ptr, nodes);
+	visible = bit_test(nodes, 8);
+	FREE_NULL_BITMAP(nodes);
+	return visible;
+}
+
+static void clear_batch(uint32_t *members, uint32_t count)
+{
+	for (uint32_t member = 0; member < count; member++) {
+		job_launch_t *plan = _job_launch_find(members[member]);
+
+		if (plan)
+			_job_launch_clear(plan, "test cleanup");
+	}
+	for (uint32_t victim = 0; victim < 8; victim++)
+		batch_victims[victim]->job_state = JOB_COMPLETE;
+}
+
+static void test_batch_lifecycle(void)
+{
+	job_record_t *owner = gpu_array(6000, 20, 8);
+	job_launch_t *plan = open_batch(owner);
+	uint32_t members[8];
+	uint32_t calls_before = preempt_calls;
+	job_record_t competitor = { .job_id = 99999, .job_state = JOB_PENDING };
+	char *reason = NULL;
+
+	REQUIRE(plan && plan->batch_size == 8);
+	memcpy(members, plan->batch_members, sizeof(members));
+	REQUIRE(find_job_record(6000)->bf_launch_array_slots == 8);
+	REQUIRE(!node_visible(find_job_record(6000)));
+	REQUIRE(!node_visible(&competitor));
+	competitor.array_job_id = 6000;
+	competitor.bf_launch_transaction = true;
+	REQUIRE(!node_visible(&competitor));
+	competitor.het_job_id = competitor.job_id;
+	REQUIRE(!node_visible(&competitor));
+	REQUIRE(preempt_calls == calls_before);
+	for (uint32_t member = 0; member < 8; member++) {
+		job_record_t *task = find_job_record(members[member]);
+		job_launch_t *task_plan = _job_launch_find(members[member]);
+
+		REQUIRE(node_visible(task));
+		REQUIRE(task->details->num_tasks == 1);
+		REQUIRE(task->details->pn_min_memory == 131072);
+		if (member)
+			REQUIRE(task->time_limit == 3600);
+		REQUIRE(_job_launch_preempt_planned_jobs(task, task_plan));
+	}
+	REQUIRE(preempt_calls == calls_before + 8);
+	for (uint32_t victim = 0; victim < 8; victim++)
+		REQUIRE(batch_victims[victim]->end_time == test_now + 300);
+	test_now += 299;
+	REQUIRE(_job_launch_preempt_planned_jobs(owner, plan));
+	REQUIRE(preempt_calls == calls_before + 8);
+	find_job_record(members[1])->job_state = JOB_CANCELLED;
+	_job_launch_clear(_job_launch_find(members[1]), "cancel one task");
+	REQUIRE(find_job_record(6000)->bf_launch_array_slots == 7);
+	REQUIRE(!node_visible(&competitor));
+	for (uint32_t victim = 0; victim < 8; victim++)
+		batch_victims[victim]->job_state = JOB_COMPLETING;
+	test_now += 2;
+	REQUIRE(_job_launch_preempt_planned_jobs(owner, plan));
+	for (uint32_t victim = 0; victim < 8; victim++)
+		batch_victims[victim]->job_state = JOB_COMPLETE;
+	for (uint32_t member = 0; member < 8; member++) {
+		job_record_t *task = find_job_record(members[member]);
+		job_launch_t *task_plan = _job_launch_find(members[member]);
+
+		if (!task_plan)
+			continue;
+		REQUIRE(_job_launch_validate(task_plan, &reason));
+		REQUIRE(!reason);
+		REQUIRE(!_job_launch_preempt_planned_jobs(task, task_plan));
+		task->node_bitmap = bit_copy(task_plan->planned_node_bitmap);
+		task->job_state = JOB_RUNNING;
+		job_array_start(task);
+		_job_launch_clear(task_plan, "job started");
+		if (member == 0) {
+			task->job_state = JOB_PENDING;
+			REQUIRE(!task->bf_launch_transaction);
+			REQUIRE(!node_visible(task));
+			task->job_state = JOB_RUNNING;
+		}
+		if (member < 7)
+			REQUIRE(!node_visible(&competitor));
+	}
+	REQUIRE(node_visible(&competitor));
+	REQUIRE(find_job_record(6000)->bf_launch_array_slots == 0);
+	REQUIRE(find_job_record(6000)->array_recs->tot_run_tasks == 7);
+	puts("PASS: batch admission, exact membership, parallel grace, partial cancellation, sibling starts, final fence release");
+}
