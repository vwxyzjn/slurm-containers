+static list_t *_job_launch_batch_probe(job_record_t *job_ptr,
+				      bitstr_t *nodes, uint32_t count,
+				      resv_exc_t *resv_exc, int *rc)
+{
+	job_record_t probe = *job_ptr;
+	job_details_t details = *job_ptr->details;
+	multi_core_data_t multicore = *details.mc_ptr;
+	gres_state_t *gres;
+	gres_job_state_t *gres_job;
+	list_t *victims;
+
+	*rc = ESLURM_NODES_BUSY;
+	if ((details.min_cpus > (NO_VAL / count)) ||
+	    (details.pn_min_cpus > (NO_VAL / count)) ||
+	    ((details.max_cpus != NO_VAL) &&
+	     (details.max_cpus > (NO_VAL / count))) ||
+	    (!(details.pn_min_memory & MEM_PER_CPU) &&
+	     (details.pn_min_memory > ((MEM_PER_CPU - 1) / count))))
+		return NULL;
+	probe.details = &details;
+	details.mc_ptr = &multicore;
+	details.num_tasks = count;
+	details.ntasks_per_node = count;
+	details.min_cpus *= count;
+	details.orig_min_cpus = details.min_cpus;
+	if (details.max_cpus != NO_VAL)
+		details.max_cpus *= count;
+	details.orig_max_cpus = details.max_cpus;
+	details.pn_min_cpus *= count;
+	details.orig_pn_min_cpus = details.pn_min_cpus;
+	if (!(details.pn_min_memory & MEM_PER_CPU))
+		details.pn_min_memory *= count;
+	details.orig_pn_min_memory = details.pn_min_memory;
+	probe.job_resrcs = NULL;
+	probe.node_bitmap_preempt = NULL;
+	probe.cpus_per_tres = xstrdup(job_ptr->cpus_per_tres);
+	probe.mem_per_tres = xstrdup(job_ptr->mem_per_tres);
+	probe.gres_list_req = gres_job_state_list_dup(job_ptr->gres_list_req);
+	probe.gres_list_req_accum = NULL;
+	gres = list_peek(probe.gres_list_req);
+	gres_job = gres->gres_data;
+	gres_job->gres_per_job *= count;
+	gres_job->gres_per_node *= count;
+	gres_job->total_gres = count;
+	victims = _het_job_select_planned_preemptee_ids(
+		&probe, nodes, 1, 1, 1, resv_exc, rc);
+	FREE_NULL_LIST(probe.gres_list_req);
+	FREE_NULL_LIST(probe.gres_list_req_accum);
+	FREE_NULL_BITMAP(probe.node_bitmap_preempt);
+	xfree(probe.cpus_per_tres);
+	xfree(probe.mem_per_tres);
+	return victims;
+}
+
+static job_launch_t *_job_launch_begin_array_batch(
+	job_record_t *job_ptr, part_record_t *part_ptr,
+	slurmdb_qos_rec_t *qos_ptr, slurmctld_resv_t *resv_ptr,
+	bool use_prefer, bitstr_t *planned_node_bitmap,
+	list_t *planned_preemptee_job_ids, resv_exc_t *resv_exc,
+	uint32_t original_time_limit)
+{
+	uint32_t count = _job_launch_batch_limit(job_ptr, planned_node_bitmap);
+	uint32_t members[32] = { 0 };
+	job_launch_t *plans[32] = { 0 };
+	uint32_t array_id = job_ptr->array_job_id;
+	uint32_t committed = 0;
+	list_t *victims = NULL;
+	int rc;
+
+	for (; count > 1; count--) {
+		victims = _job_launch_batch_probe(job_ptr, planned_node_bitmap,
+						count, resv_exc, &rc);
+		if ((rc == SLURM_SUCCESS) && victims && list_count(victims))
+			break;
+		FREE_NULL_LIST(victims);
+	}
+	if (count < 2)
+		return _job_launch_begin(job_ptr, part_ptr, qos_ptr, resv_ptr,
+			use_prefer, planned_node_bitmap, planned_preemptee_job_ids);
+	for (uint32_t member = 0; member < count; member++) {
+		job_record_t *owner = member ? find_job_record(array_id) : job_ptr;
+
+		if (!owner)
+			goto rollback;
+		if (member)
+			_set_job_time_limit(owner, original_time_limit);
+		plans[member] = _job_launch_begin_member(owner, part_ptr, qos_ptr,
+			resv_ptr, use_prefer, planned_node_bitmap, victims, plans[0]);
+		if (!plans[member])
+			goto rollback;
+		members[member] = owner->job_id;
+		committed++;
+	}
+	if (!bf_launch_txn_share_nodes(members, count))
+		goto rollback;
+	for (uint32_t member = 0; member < count; member++) {
+		job_record_t *owner = find_job_record(members[member]);
+
+		plans[member]->batch_members = xcalloc(count, sizeof(*members));
+		memcpy(plans[member]->batch_members, members,
+		       count * sizeof(*members));
+		plans[member]->batch_size = count;
+		plans[member]->batch_request = _job_launch_batch_request(owner);
+		_job_launch_update_status(owner, plans[member], time(NULL), false);
+	}
+	info("%pJ array node batch committed: %u tasks, %d planned preemptions",
+	     job_ptr, count, list_count(victims));
+	FREE_NULL_LIST(victims);
+	return plans[0];
+rollback:
+	for (uint32_t member = 0; member < committed; member++)
+		_job_launch_clear(plans[member], "array batch admission failed before signaling");
+	FREE_NULL_LIST(victims);
+	return NULL;
+}
