+	REQUIRE(!open_batch(owner));
+	REQUIRE(preempt_calls == calls_before);
+	REQUIRE(find_job_record(6400)->bf_launch_array_slots == 0);
+	REQUIRE(node_visible(find_job_record(6400)));
+	iter = list_iterator_create(job_list);
+	while ((task = list_next(iter))) {
+		if ((task->array_job_id == 6400) && (task != owner))
+			REQUIRE(task->time_limit == 3600);
+	}
+	list_iterator_destroy(iter);
+	reject_admission = false;
+	clear_batch(NULL, 0);
+	owner = gpu_array(6500, 20, 8);
+	plan = open_batch(owner);
+	REQUIRE(plan && plan->batch_size == 8);
+	memcpy(members, plan->batch_members, sizeof(members));
+	owner->details->cpus_per_task = 24;
+	REQUIRE(!_job_launch_validate(plan, &reason));
