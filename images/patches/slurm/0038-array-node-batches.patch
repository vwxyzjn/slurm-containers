+	owner = gpu_array(6600, 20, 8);
+	bf_max_job_array_node_batch = 1;
+	plan = open_batch(owner);
+	REQUIRE(plan && !plan->batch_size);
+	REQUIRE(list_count(plan->planned_preemptee_job_ids) == 1);
