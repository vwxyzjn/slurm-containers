+static char *_job_launch_batch_request(job_record_t *job_ptr)
+{
+	job_details_t *details = job_ptr->details;
+	multi_core_data_t *multicore = details ? details->mc_ptr : NULL;
+	char *request;
+
+	if (!details || !multicore)
+		return NULL;
+	request = xstrdup_printf(
+		"%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%llu,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s",
+		details->min_nodes, details->max_nodes,
+		details->orig_min_cpus, details->orig_max_cpus,
+		details->cpus_per_task, details->orig_cpus_per_task,
+		details->num_tasks, details->ntasks_per_node,
+		details->ntasks_per_tres, details->overcommit,
+		details->whole_node, details->share_res, details->core_spec,
+		details->orig_pn_min_cpus, details->pn_min_tmp_disk,
+		(unsigned long long) details->orig_pn_min_memory,
+		details->task_dist, multicore->boards_per_node,
+		multicore->sockets_per_board, multicore->sockets_per_node,
+		multicore->cores_per_socket, multicore->threads_per_core,
+		multicore->ntasks_per_board, multicore->ntasks_per_socket,
+		multicore->ntasks_per_core, multicore->plane_size,
+		job_ptr->tres_per_job, job_ptr->tres_per_node,
+		job_ptr->tres_per_socket, job_ptr->tres_per_task,
+		job_ptr->cpus_per_tres, job_ptr->mem_per_tres,
+		details->req_nodes, details->exc_nodes, details->features,
+		details->dependency, job_ptr->licenses);
+	return request;
+}
+
+static bool _job_launch_batch_request_matches(job_record_t *job_ptr,
+					    job_launch_t *launch)
+{
+	char *request;
+	bool matches;
+
+	if (!launch->batch_request)
+		return true;
+	request = _job_launch_batch_request(job_ptr);
+	matches = !xstrcmp(request, launch->batch_request);
+	xfree(request);
+	return matches;
+}
+
+static uint32_t _job_launch_batch_limit(job_record_t *job_ptr,
+				      bitstr_t *nodes)
+{
+	job_details_t *details = job_ptr->details;
+	job_array_struct_t *array = job_ptr->array_recs;
+	gres_state_t *gres;
+	gres_job_state_t *gres_job;
+	uint32_t limit;
+	uint64_t occupied;
+
+	if ((bf_max_job_array_node_batch < 2) || !array ||
+	    !job_ptr->array_job_id || job_ptr->het_job_id || !details ||
+	    !details->mc_ptr || (details->num_tasks != 1) ||
+	    (details->min_nodes != 1) || (details->max_nodes != 1) ||
+	    details->whole_node || details->overcommit ||
+	    details->depend_list || details->expanding_jobid ||
+	    details->arbitrary_tpn || details->pn_min_tmp_disk ||
+	    !details->pn_min_memory ||
+	    job_ptr->license_list || job_ptr->burst_buffer || job_ptr->fed_details ||
+	    (job_ptr->bit_flags & GRES_ENFORCE_BIND) ||
+	    !details->cpus_per_task || (details->cpus_per_task == NO_VAL16) ||
+	    (bit_set_count(nodes) != 1) ||
+	    xstrcmp(slurm_conf.select_type, "select/cons_tres") ||
+	    !job_ptr->gres_list_req || (list_count(job_ptr->gres_list_req) != 1))
+		return 1;
+	gres = list_peek(job_ptr->gres_list_req);
+	gres_job = gres->gres_data;
+	if (xstrcmp(gres->gres_name, "gpu") ||
+	    (gres->config_flags & GRES_CONF_SHARED) ||
+	    (gres_job->gres_per_task != 1) || gres_job->gres_per_socket ||
+	    (gres_job->gres_per_job > 1) || (gres_job->gres_per_node > 1) ||
+	    (details->mc_ptr->ntasks_per_socket &&
+	     (details->mc_ptr->ntasks_per_socket != NO_VAL16) &&
+	     (details->mc_ptr->ntasks_per_socket != INFINITE16)) ||
+	    (details->mc_ptr->ntasks_per_board &&
+	     (details->mc_ptr->ntasks_per_board != NO_VAL16) &&
+	     (details->mc_ptr->ntasks_per_board != INFINITE16)))
+		return 1;
+	if (job_ptr->bf_launch_array_slots >= bf_max_job_array_launch)
+		return 1;
+	limit = MIN((uint32_t) bf_max_job_array_node_batch, array->task_cnt);
+	limit = MIN(limit, bf_max_job_array_launch - job_ptr->bf_launch_array_slots);
+	occupied = (uint64_t) array->tot_run_tasks + job_ptr->bf_launch_array_slots;
+	if (array->max_run_tasks) {
+		if (occupied >= array->max_run_tasks)
+			return 1;
+		limit = MIN(limit, array->max_run_tasks - occupied);
+	}
+	return MAX(limit, 1);
+}
