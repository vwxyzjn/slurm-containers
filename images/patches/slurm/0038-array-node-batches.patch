+	REQUIRE(preempt_calls == calls_before + 2);
+	REQUIRE(!batch_victims[2]->preempt_time);
+	clear_batch(members, 2);
+	owner = gpu_array(6200, 20, 20);
+	bf_max_job_array_launch = 3;
+	plan = open_batch(owner);
+	REQUIRE(plan && plan->batch_size == 3);
+	memcpy(members, plan->batch_members, 3 * sizeof(*members));
+	REQUIRE(find_job_record(6200)->bf_launch_array_slots == 3);
+	clear_batch(members, 3);
+	bf_max_job_array_launch = 100;
+	owner = gpu_array(6300, 20, 20);
+	owner->details->pn_min_memory = MEM_PER_CPU | 4096;
+	owner->details->orig_pn_min_memory = MEM_PER_CPU | 4096;
+	probe_capacity = 3;
+	plan = open_batch(owner);
+	REQUIRE(plan && plan->batch_size == 3);
+	memcpy(members, plan->batch_members, 3 * sizeof(*members));
+	clear_batch(members, 3);
+	probe_capacity = 8;
+	puts("PASS: array %N, task-counted preparation cap, minimal victims, smaller feasible batch, per-CPU memory");
+}
