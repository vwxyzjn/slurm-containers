+/*
+ * het_batch_launch_superseded - see slurmctld.h
+ */
+extern bool het_batch_launch_superseded(job_record_t *job_ptr,
+					const char *node_name,
+					uint16_t restart_cnt)
+{
+	/* A component, attached or detached (requeued alone, pending) */
+	if (!job_ptr || !job_ptr->batch_flag ||
+	    !(job_ptr->bit_flags & HETJOB_BATCH_EACH))
+		return false;
+	/* Sent before the component was requeued (and maybe started again) */
+	if (restart_cnt != job_ptr->restart_cnt)
+		return true;
+	/* Sent to a batch host the component lost since (relaunched) */
+	return (node_name && xstrcmp(job_ptr->batch_host, node_name));
+}
+
+/*
+ * het_batch_launch_fail_ignore - see slurmctld.h
+ */
+extern bool het_batch_launch_fail_ignore(uint32_t job_id,
+					 const char *node_name,
+					 uint16_t restart_cnt, bool no_resp)
+{
+	job_record_t *job_ptr;
+
+	xassert(verify_lock(JOB_LOCK, WRITE_LOCK));
+
+	if (!(job_ptr = find_job_record(job_id)) ||
+	    !(job_ptr->bit_flags & HETJOB_BATCH_EACH))
+		return false;
+	if (het_batch_launch_superseded(job_ptr, node_name, restart_cnt)) {
+		info("%s: ignoring the failed batch launch of %pJ to %s (restart count %u): superseded, its batch host is now %s (restart count %u, HetBatchRestart=%u)",
+		     __func__, job_ptr, node_name ? node_name : "(unknown)",
+		     restart_cnt,
+		     job_ptr->batch_host ? job_ptr->batch_host : "(none)",
+		     job_ptr->restart_cnt, job_ptr->het_batch_restart);
+		return true;
+	}
+	/*
+	 * No response, and the script was relaunched since the first launch:
+	 * the launch that failed is either the current relaunch or one it
+	 * superseded (node_name not known). Either way the component keeps
+	 * running: once its batch host is marked DOWN the script is
+	 * relaunched on the next node (kill_running_job_by_node_ptr()). The
+	 * launch is not sent again: if it did reach slurmd and only the
+	 * reply was lost, slurmd would refuse a second batch step and
+	 * requeue or kill the component (req.c:_rpc_batch_job()).
+	 */
+	if (no_resp && job_ptr->het_batch_restart &&
+	    IS_JOB_RUNNING(job_ptr) && !IS_JOB_COMPLETING(job_ptr)) {
+		info("%s: relaunch %u of the batch script of %pJ got no response from %s; %pJ keeps running, and its script is relaunched on the next node once %s is marked DOWN",
+		     __func__, job_ptr->het_batch_restart, job_ptr,
+		     node_name ? node_name : "its batch host", job_ptr,
+		     job_ptr->batch_host ? job_ptr->batch_host : "(none)");
+		return true;
+	}
+	return false;
+}
