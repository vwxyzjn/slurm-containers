+
+extern void het_job_attach(job_record_t *job_ptr)
+{
+	job_record_t *het_leader;
+
+	if (!job_ptr->het_join_id)
+		return;
+
+	het_leader = find_job_record(job_ptr->het_join_id);
+	if (!het_leader || !het_leader->het_job_list) {
+		error("%s: hetjob %u of %pJ not found, running it as an ordinary job",
+		      __func__, job_ptr->het_join_id, job_ptr);
+		job_ptr->het_join_id = 0;
+		job_ptr->het_join_offset = 0;
+		return;
+	}
+
+	job_ptr->het_job_id = het_leader->het_job_id;
+	job_ptr->het_job_offset = job_ptr->het_join_offset;
+	job_ptr->het_details = het_leader->het_details;
+	job_ptr->bit_flags |= (het_leader->bit_flags & HETJOB_BATCH_EACH);
+	job_ptr->het_join_id = 0;
+	job_ptr->het_join_offset = 0;
+
+	list_append(het_leader->het_job_list, job_ptr);
+	list_sort(het_leader->het_job_list, _sort_het_comp_by_offset);
+	_het_job_rebuild_id_set(het_leader);
