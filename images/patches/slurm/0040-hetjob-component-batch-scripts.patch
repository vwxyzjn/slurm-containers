+/*
+ * Hetjobs submitted with sbatch --het-batch=each (HETJOB_BATCH_EACH on every
+ * component record):
+ *
+ * Every component runs its own batch script on its first node and ends on its
+ * own (batch script exit, NODE_FAIL, scancel <id>+N). The hetjob itself - the
+ * leader record, het_job_list and the component job IDs - lives until its last
+ * component ends, and scancel <leader id> still cancels every component.
+ *
+ * A component requeued alone cannot wait for resources as a member of the
+ * hetjob: the schedulers treat a pending hetjob component as part of a gang
+ * that starts together (backfill _het_job_start_*(), launch transactions,
+ * _schedule() skips hetjob components). So while it is pending it is
+ * detached: het_job_id/het_job_offset move to het_join_id/het_join_offset, it
+ * is scheduled like any other job, and select_nodes() attaches it to the
+ * hetjob again when it starts (het_job_attach()). Only components other than
+ * the leader can be requeued alone: the leader record carries the hetjob.
+ */
+extern bool het_job_batch_each(job_record_t *job_ptr)
+{
+	return (job_ptr->het_job_id &&
+		(job_ptr->bit_flags & HETJOB_BATCH_EACH));
+}
+
+static bool _het_job_is_leader(job_record_t *job_ptr)
+{
+	return (job_ptr->het_job_id &&
+		(job_ptr->het_job_id == job_ptr->job_id));
+}
+
+/*
+ * find_het_job_record() that also finds a pending job waiting to become
+ * component <het_job_id>+<offset> (detached, see _het_job_detach()). Such a
+ * job has job ID het_job_id + offset, like every component.
+ */
+static job_record_t *_find_het_comp(uint32_t het_job_id, uint32_t offset)
+{
+	job_record_t *job_ptr = find_het_job_record(het_job_id, offset);
+
+	if (!job_ptr && (job_ptr = find_job_record(het_job_id + offset)) &&
+	    ((job_ptr->het_join_id != het_job_id) ||
+	     (job_ptr->het_join_offset != offset)))
+		job_ptr = NULL;
+
+	return job_ptr;
+}
+
+/* SchedulerParameters=het_batch_each allows sbatch --het-batch=each */
+static bool _het_batch_each_enabled(void)
+{
+	static time_t sched_update = 0;
+	static bool enabled = false;
+
+	if (sched_update != slurm_conf.last_update) {
+		enabled = xstrcasestr(slurm_conf.sched_params,
+				      "het_batch_each");
+		sched_update = slurm_conf.last_update;
+	}
+
+	return enabled;
+}
+
+static int _foreach_het_id_set_add(void *x, void *arg)
+{
+	job_record_t *het_job = x;
+	hostset_t **hs = arg;
+	char tmp_str[32];
+
+	snprintf(tmp_str, sizeof(tmp_str), "%u", het_job->job_id);
+	if (*hs)
+		(void) hostset_insert(*hs, tmp_str);
+	else
+		*hs = hostset_create(tmp_str);
+
+	return 0;
+}
+
+static int _foreach_het_id_set_copy(void *x, void *arg)
+{
+	job_record_t *het_job = x;
+
+	xfree(het_job->het_job_id_set);
+	het_job->het_job_id_set = xstrdup(arg);
+
+	return 0;
+}
+
+/*
+ * Rebuild het_job_id_set on every component after het_job_list changed.
+ * After a restart read_config.c:_validate_het_jobs() rebuilds het_job_list
+ * from the leader's het_job_id_set, so it must list exactly the attached
+ * components. Same format as proc_req.c:_create_het_job_id_set().
+ */
+static void _het_job_rebuild_id_set(job_record_t *het_leader)
+{
+	hostset_t *hs = NULL;
+	char *ranged, *id_set, *end;
+
+	(void) list_for_each(het_leader->het_job_list,
+			     _foreach_het_id_set_add, &hs);
+	if (!hs)
+		return;
+	ranged = hostset_ranged_string_xmalloc(hs);
+	hostset_destroy(hs);
+
+	id_set = ranged;
+	if (id_set[0] == '[') {
+		if ((end = strchr(id_set, ']')))
+			end[0] = '\0';
+		id_set++;
+	}
+	(void) list_for_each(het_leader->het_job_list,
+			     _foreach_het_id_set_copy, id_set);
+	xfree(ranged);
+}
+
+static int _sort_het_comp_by_offset(void *x, void *y)
+{
+	job_record_t *job_ptr1 = *(job_record_t **) x;
+	job_record_t *job_ptr2 = *(job_record_t **) y;
+
+	if (job_ptr1->het_job_offset < job_ptr2->het_job_offset)
+		return -1;
+	if (job_ptr1->het_job_offset > job_ptr2->het_job_offset)
+		return 1;
+	return 0;
+}
+
+static int _foreach_het_comp_pending(void *x, void *arg)
+{
+	job_record_t *het_job = x;
+
+	return ((het_job != arg) && IS_JOB_PENDING(het_job)) ? 1 : 0;
