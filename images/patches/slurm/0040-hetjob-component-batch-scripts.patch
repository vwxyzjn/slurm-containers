+/*
+ * het_batch_launch_pending - see slurmctld.h
+ */
+extern void het_batch_launch_pending(job_record_t *job_ptr)
+{
+	step_record_t *step_ptr;
+
+	xassert(verify_lock(JOB_LOCK, WRITE_LOCK));
+
+	if (!job_ptr || !(job_ptr->bit_flags & HETJOB_BATCH_EACH) ||
+	    !(step_ptr = _het_batch_step(job_ptr)))
+		return;
+	step_ptr->time_last_active = time(NULL);
+}
