+
+static int _find_het_joiner(void *x, void *key)
+{
+	job_record_t *job_ptr = x;
+	uint32_t het_job_id = *(uint32_t *) key;
+
+	return ((job_ptr->het_join_id == het_job_id) &&
+		!IS_JOB_FINISHED(job_ptr));
