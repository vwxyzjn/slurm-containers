diff --git a/src/common/slurm_opt.c b/src/common/slurm_opt.c
index f956cfd..e80c221 100644
--- a/src/common/slurm_opt.c
+++ b/src/common/slurm_opt.c
@@ -2123,6 +2123,44 @@ static slurm_cli_opt_t slurm_opt_kill_on_invalid_dep = {
 	.reset_func = arg_reset_kill_on_invalid_dep,
 };
 
+/*
+ * --het-batch=leader|each (sbatch, heterogeneous jobs): "each" runs the batch
+ * script on the first node of every component, with SLURM_HET_JOB_OFFSET set,
+ * and lets every component end on its own. Carried in job_desc_msg_t.bitflags
+ * as HETJOB_BATCH_EACH, like --spread-job and --use-min-nodes.
+ */
+static int arg_set_het_batch(slurm_opt_t *opt, const char *arg)
+{
+	if (!xstrcasecmp(arg, "each"))
+		opt->job_flags |= HETJOB_BATCH_EACH;
+	else if (!xstrcasecmp(arg, "leader"))
+		opt->job_flags &= ~HETJOB_BATCH_EACH;
+	else {
+		error("Invalid --het-batch specification, use \"leader\" or \"each\"");
+		return SLURM_ERROR;
+	}
+
+	return SLURM_SUCCESS;
+}
+static char *arg_get_het_batch(slurm_opt_t *opt)
+{
+	if (opt->job_flags & HETJOB_BATCH_EACH)
+		return xstrdup("each");
+	return xstrdup("leader");
+}
+static void arg_reset_het_batch(slurm_opt_t *opt)
+{
+	opt->job_flags &= ~HETJOB_BATCH_EACH;
+}
+static slurm_cli_opt_t slurm_opt_het_batch = {
+	.name = "het-batch",
+	.has_arg = required_argument,
+	.val = LONG_OPT_HET_BATCH,
+	.set_func_sbatch = arg_set_het_batch,
+	.get_func = arg_get_het_batch,
+	.reset_func = arg_reset_het_batch,
+};
+
