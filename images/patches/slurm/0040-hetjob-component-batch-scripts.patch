+/*
+ * --het-batch=each: true if the component's batch script should run on its
+ * batch host, which is registering now, but that node has not reported the
+ * batch step since startup_time (_purge_missing_jobs()).
+ *
+ * The job's time_last_active, which the stock test uses, says nothing here:
+ * every registration of the job's first node refreshes it for any step of the
+ * job (validate_jobs_on_node()), and after a relaunch the new batch host is
+ * the first node left and runs the component's agent steps. A relaunch that
+ * never arrived (the agent's queue is lost when slurmctld restarts, and
+ * `scontrol reconfigure` restarts it in 25.05; or a launch that got no
+ * response from a batch host that stays up) then left the component RUNNING
+ * without a script, for good. The batch step's own time_last_active is
+ * refreshed when its batch host reports it and while the agent still holds
+ * its launch (het_batch_launch_pending()). Its start time is the launch (or
+ * relaunch) time, which gives the script BatchStartTimeout to start.
+ */
+static bool _het_batch_script_missing(job_record_t *job_ptr,
+				      time_t startup_time)
+{
+	step_record_t *step_ptr = _het_batch_step(job_ptr);
+
+	if (!step_ptr)
+		return ((job_ptr->time_last_active < startup_time) &&
+			(job_ptr->start_time < startup_time));
+	return ((step_ptr->time_last_active < startup_time) &&
+		(step_ptr->start_time < startup_time));
