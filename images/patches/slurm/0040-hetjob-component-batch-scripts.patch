+static step_record_t *_het_batch_step(job_record_t *job_ptr)
+{
+	slurm_step_id_t step_id = {
+		.job_id = job_ptr->job_id,
+		.step_id = SLURM_BATCH_SCRIPT,
+		.step_het_comp = NO_VAL,
+	};
+
+	return find_step_record(job_ptr, &step_id);
+}
