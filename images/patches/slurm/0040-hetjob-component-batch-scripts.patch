+/*
+ * Detach a component of a --het-batch=each hetjob that was requeued alone, so
+ * it is scheduled like an ordinary job until het_job_attach() puts it back.
+ * A component that went back to pending with other components of its hetjob
+ * (the whole hetjob requeued, or a hetjob launch transaction rolled back) is
+ * part of that gang and stays attached.
+ */
+static void _het_job_detach(job_record_t *job_ptr)
+{
+	job_record_t *het_leader;
+
+	if (!het_job_batch_each(job_ptr) || _het_job_is_leader(job_ptr) ||
+	    !IS_JOB_PENDING(job_ptr))
+		return;
+
+	het_leader = find_job_record(job_ptr->het_job_id);
+	if (het_leader && het_leader->het_job_list &&
+	    list_find_first(het_leader->het_job_list,
+			    _foreach_het_comp_pending, job_ptr))
+		return;
+
+	info("%s: %pJ requeued alone, detached from hetjob %u until it starts again as component +%u",
+	     __func__, job_ptr, job_ptr->het_job_id, job_ptr->het_job_offset);
+
+	job_ptr->het_join_id = job_ptr->het_job_id;
+	job_ptr->het_join_offset = job_ptr->het_job_offset;
+	job_ptr->het_job_id = 0;
+	job_ptr->het_job_offset = 0;
+	job_ptr->het_details = NULL;	/* owned by the leader */
+	xfree(job_ptr->het_job_id_set);
+
+	if (het_leader && het_leader->het_job_list) {
+		(void) list_delete_ptr(het_leader->het_job_list, job_ptr);
+		_het_job_rebuild_id_set(het_leader);
+	} else {
+		error("%s: hetjob leader %u of %pJ not found",
+		      __func__, job_ptr->het_join_id, job_ptr);
+	}
+	last_job_update = time(NULL);
+}
+
+extern int het_job_join_test(job_record_t *job_ptr)
+{
+	job_record_t *het_leader;
+
+	xassert(job_ptr->het_join_id);
+
+	het_leader = find_job_record(job_ptr->het_join_id);
+	if (!het_leader || !het_leader->het_job_list ||
+	    !_het_job_is_leader(het_leader) ||
+	    !het_job_batch_each(het_leader))
+		return ESLURM_INVALID_JOB_ID;
+
+	/*
+	 * The hetjob is being (re)started as a gang (all of it was requeued):
+	 * attaching a running component to a pending gang would break the
+	 * all-components-start-together assumption of the hetjob launch code.
+	 */
+	if (list_find_first(het_leader->het_job_list,
+			    _foreach_het_comp_pending, NULL))
+		return ESLURM_JOB_PENDING;
+
+	/* Every attached component has ended: nothing left to join */
+	if (!list_find_first(het_leader->het_job_list,
+			     _foreach_het_comp_active, NULL))
+		return ESLURM_INVALID_JOB_ID;
