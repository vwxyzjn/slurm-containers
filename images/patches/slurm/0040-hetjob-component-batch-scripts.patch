+/*
+ * A pending job that would join a hetjob that has ended can never start.
+ * Cancel it, the same way _kill_dependent() cancels a job whose dependency
+ * can never be satisfied.
+ */
+static void _kill_het_joiner(job_record_t *job_ptr)
+{
+	time_t now = time(NULL);
+
+	info("%s: hetjob %u has ended, cancelling %pJ",
+	     __func__, job_ptr->het_join_id, job_ptr);
+	job_state_set(job_ptr, JOB_CANCELLED);
+	xfree(job_ptr->state_desc);
+	xstrfmtcat(job_ptr->state_desc, "hetjob %u ended before this job started",
+		   job_ptr->het_join_id);
+	job_ptr->start_time = now;
+	job_ptr->end_time = now;
+	job_completion_logger(job_ptr, false);
+	last_job_update = now;
