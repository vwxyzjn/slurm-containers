+/*
+ * --het-join=<jobid> (sbatch): start as a new component of running hetjob
+ * <jobid>, submitted with --het-batch=each and --het-reserve. The job gets the
+ * lowest free reserved job ID <jobid>+N, is scheduled alone and becomes
+ * component <jobid>+N when it starts.
+ */
+static int arg_set_het_join(slurm_opt_t *opt, const char *arg)
+{
+	if (!opt->sbatch_opt)
+		return SLURM_ERROR;
+
+	opt->sbatch_opt->het_join_id = parse_int("--het-join", arg, true);
+
+	return SLURM_SUCCESS;
+}
+static char *arg_get_het_join(slurm_opt_t *opt)
+{
+	if (!opt->sbatch_opt)
+		return xstrdup("invalid-context");
+
+	return xstrdup_printf("%u", opt->sbatch_opt->het_join_id);
+}
+static void arg_reset_het_join(slurm_opt_t *opt)
+{
+	if (opt->sbatch_opt)
+		opt->sbatch_opt->het_join_id = 0;
+}
+static slurm_cli_opt_t slurm_opt_het_join = {
+	.name = "het-join",
+	.has_arg = required_argument,
+	.val = LONG_OPT_HET_JOIN,
+	.set_func_sbatch = arg_set_het_join,
+	.get_func = arg_get_het_join,
+	.reset_func = arg_reset_het_join,
+};
+
+/*
+ * --het-reserve=<count> (sbatch, heterogeneous jobs with --het-batch=each):
+ * reserve job IDs <jobid>+0 .. <jobid>+count-1 for the hetjob, for its
+ * components and for jobs joining it later with --het-join.
+ */
+static int arg_set_het_reserve(slurm_opt_t *opt, const char *arg)
+{
+	int tmp;
+
+	if (!opt->sbatch_opt)
+		return SLURM_ERROR;
+
+	tmp = parse_int("--het-reserve", arg, true);
+	if (tmp > HET_JOB_RESERVE_MAX) {
+		error("Invalid --het-reserve specification, at most %d",
+		      HET_JOB_RESERVE_MAX);
+		return SLURM_ERROR;
+	}
+	opt->sbatch_opt->het_reserve = tmp;
+
+	return SLURM_SUCCESS;
+}
+static char *arg_get_het_reserve(slurm_opt_t *opt)
+{
+	if (!opt->sbatch_opt)
+		return xstrdup("invalid-context");
+
+	return xstrdup_printf("%u", opt->sbatch_opt->het_reserve);
+}
+static void arg_reset_het_reserve(slurm_opt_t *opt)
+{
+	if (opt->sbatch_opt)
+		opt->sbatch_opt->het_reserve = 0;
+}
+static slurm_cli_opt_t slurm_opt_het_reserve = {
+	.name = "het-reserve",
+	.has_arg = required_argument,
+	.val = LONG_OPT_HET_RESERVE,
+	.set_func_sbatch = arg_set_het_reserve,
