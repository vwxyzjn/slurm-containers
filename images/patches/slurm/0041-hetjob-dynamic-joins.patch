+/*
+ * sbatch --het-reserve=K: job IDs <leader>+0 .. <leader>+K-1 belong to the
+ * hetjob: its components at submit, then jobs that join it with --het-join.
+ * Joined components keep job_id == het_job_id + het_job_offset, which code
+ * like _walk_jobs_by_selected_step() ("scancel <id>+<offset>") relies on.
+ * The reservation lives in the leader's job record (het_reserve, saved in
+ * the job state) and ends when that record is purged. het_reserve_leaders
+ * lists the leaders holding one, so get_next_job_id() can skip their IDs.
+ */
+static void _het_reserve_add(uint32_t leader_id)
+{
+	uint32_t *id = xmalloc(sizeof(*id));
+
+	*id = leader_id;
+	if (!het_reserve_leaders)
+		het_reserve_leaders = list_create(xfree_ptr);
+	list_append(het_reserve_leaders, id);
+}
+
+typedef struct {
+	uint32_t job_id;
+	job_record_t *leader;
+} het_reserve_find_t;
+
+static int _het_reserve_find(void *x, void *arg)
+{
+	uint32_t leader_id = *(uint32_t *) x;
+	het_reserve_find_t *find = arg;
+	job_record_t *leader;
+
+	if ((find->job_id < leader_id) ||
+	    ((find->job_id - leader_id) >= HET_JOB_RESERVE_MAX))
+		return 0;
+	if (!(leader = find_job_record(leader_id)) ||
+	    ((find->job_id - leader_id) >= leader->het_reserve))
+		return 0;
+	find->leader = leader;
+	return 1;
+}
+
+/* RET the hetjob leader that reserved job_id with --het-reserve, or NULL */
+static job_record_t *_het_reserve_owner(uint32_t job_id)
+{
+	het_reserve_find_t find = { .job_id = job_id };
+
+	if (!het_reserve_leaders)
+		return NULL;
+	(void) list_find_first(het_reserve_leaders, _het_reserve_find, &find);
+	return find.leader;
+}
+
+/* Drop leaders whose record was purged */
+static int _het_reserve_stale(void *x, void *arg)
+{
+	job_record_t *leader = find_job_record(*(uint32_t *) x);
+
+	return (!leader || !leader->het_reserve) ? 1 : 0;
+}
+
+extern void het_job_reserve_ids(job_record_t *het_leader, uint32_t cnt)
+{
+	xassert(het_leader->het_job_id == het_leader->job_id);
+
+	het_leader->het_reserve = cnt;
+	_het_reserve_add(het_leader->job_id);
+}
+
+/*
+ * --het-join: validate a request to join hetjob job_desc->het_join_id and
+ * find the job ID it gets: the lowest free reserved ID <leader>+k, k > 0.
+ * The job is scheduled alone, as an ordinary job, and becomes component +k
+ * when it starts (het_job_attach()).
